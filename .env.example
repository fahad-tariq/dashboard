ADDR=:8080
IDEAS_PATH=/data/ideas.md
UPLOADS_DIR=/data/uploads
PERSONAL_PATH=/data/personal.md
FAMILY_PATH=/data/family.md
MAINTENANCE_PATH=/data/maintenance.md
HOUSE_PROJECTS_PATH=/data/house-projects.md
DB_PATH=/data/db/dashboard.db
# Bearer token for /api/v1 (at least 32 characters; the API is not mounted otherwise).
# Generate: openssl rand -hex 32
DASHBOARD_API_TOKEN=change-me
# Separate token MCP clients use to reach the MCP sidecar (at least 32 characters,
# must differ from DASHBOARD_API_TOKEN).
MCP_TOKEN=change-me-too
# Set to true to expose delete_todo, remove_substep, clear_carried_plan and delete_commentary.
MCP_ALLOW_DESTRUCTIVE=false

# Auth (leave DASHBOARD_PASSWORD_HASH empty to disable auth)
# Generate hash: htpasswd -nbBC 10 "" 'your-password' | cut -d: -f2
DASHBOARD_PASSWORD_HASH=
SESSION_LIFETIME=720h
USER_DATA_DIR=/data/users
# Set to false for local HTTP development (defaults to true)
DASHBOARD_SECURE_COOKIES=true
# IANA timezone for greeting, planner dates, and timestamps (defaults to UTC)
# Example: Australia/Sydney, America/New_York
DASHBOARD_TIMEZONE=Australia/Sydney
