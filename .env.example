# Docker Compose substitutes only some of these into the containers: the
# password hash, tokens, MCP_ALLOW_DESTRUCTIVE, SESSION_LIFETIME,
# DASHBOARD_SECURE_COOKIES, DASHBOARD_TIMEZONE and the compose-only values at the
# end. Paths, ADDR and DASHBOARD_TRUSTED_PROXIES are fixed in docker-compose.yml.
# The paths below are the binary's defaults, for running without Compose.
ADDR=:8080
IDEAS_PATH=/data/ideas.md
UPLOADS_DIR=/data/uploads
PERSONAL_PATH=/data/personal.md
FAMILY_PATH=/data/family.md
MAINTENANCE_PATH=/data/maintenance.md
HOUSE_PROJECTS_PATH=/data/house-projects.md
DB_PATH=/data/db/dashboard.db
USER_DATA_DIR=/data/users

# Generate hash: htpasswd -nbBC 10 "" 'your-password' | cut -d: -f2
# With no user able to log in, this creates admin@localhost; with neither, the
# server refuses to start.
DASHBOARD_PASSWORD_HASH=
# For local development only: DASHBOARD_AUTH=disabled with a loopback ADDR
# (e.g. ADDR=127.0.0.1:8080). Any other ADDR is refused.
DASHBOARD_AUTH=enabled
# CIDRs of reverse proxies (e.g. Caddy) whose X-Forwarded-For is trusted for
# login and API rate limiting. Empty means the direct peer address is used.
DASHBOARD_TRUSTED_PROXIES=
SESSION_LIFETIME=720h
# true or false; false only for plain-HTTP local development.
DASHBOARD_SECURE_COOKIES=true
# IANA timezone for "today", planner dates and timestamps
# (defaults to the process's local zone, which is UTC in the container).
DASHBOARD_TIMEZONE=Australia/Sydney

# Bearer token for /api/v1. Leave empty to keep the API off; otherwise at least
# 32 characters. Generate: openssl rand -hex 32
DASHBOARD_API_TOKEN=
# MCP sidecar: the token MCP clients send (at least 32 characters, different
# from DASHBOARD_API_TOKEN). Without both, the dashboard-mcp container exits
# and Compose keeps restarting it; start only the dashboard service instead.
MCP_TOKEN=
# Set to true to expose delete_todo, remove_substep, clear_carried_plan and delete_commentary.
MCP_ALLOW_DESTRUCTIVE=false

# Compose only
# VERSION=dev
# DASHBOARD_PORT=8081
# DASHBOARD_UID=10001
# DASHBOARD_GID=10001
